{
    "name": "magicpay/magicpay-php",
    "description": "Official PHP SDK for the MagicPay payment API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "magicpay",
        "payment",
        "payments",
        "3ds",
        "wallet"
    ],
    "homepage": "https://magicpay.ai",
    "support": {
        "issues": "https://github.com/Magicpay-ai/MagicpaySDK/issues",
        "source": "https://github.com/Magicpay-ai/MagicpaySDK",
        "docs": "https://magicpay.gitbook.io/magicpay-documentation"
    },
    "authors": [
        {
            "name": "MagicPay",
            "email": "ai@magicpay.ai"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "MagicPay\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagicPay\\Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "php php/tests/run.php"
    }
}

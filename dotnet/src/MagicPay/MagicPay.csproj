<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>MagicPay</RootNamespace>
    <PackageId>MagicPay</PackageId>
    <Version>0.1.0</Version>
    <Authors>MagicPay</Authors>
    <Description>Official .NET SDK for the MagicPay payment API.</Description>
    <PackageProjectUrl>https://magicpay.ai</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>magicpay;payment;payments;3ds;wallet;turkey</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
